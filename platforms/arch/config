function install_pacman_packages {
  sudo pacman -Syyu --noconfirm --needed "$@"
}

function install_yay_packages {
  yay -Sy --answerclean N --answerdiff N --cleanafter --noremovemake --noconfirm --needed "$@"
}

function install_go_packages {
  local package
  for package in "$@"; do
    go install "$package"
  done
}
