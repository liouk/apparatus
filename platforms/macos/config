APPARATUS_BIN_DIR="$HOME/.local/bin"

# Manage personal Git and SSH credentials.
MANAGE_PERSONAL_GIT_AND_SSH=true

function install_brew_packages {
  brew install "$@"
}

function install_cask_packages {
  brew install --cask "$@"
}

function install_npm_packages {
  npm install --global "$@"
}

# Apple's OpenSSH does not support FIDO2 key recovery.
function ssh_keygen {
  "$(brew --prefix openssh)/bin/ssh-keygen" "$@"
}
