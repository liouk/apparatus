{
  "position": "top",
  "spacing": 0,
  "modules-left": ["sway/workspaces", "sway/mode", "custom/media"],
  "modules-center": ["clock"],
  "modules-right": ["custom/google-calendar", "tray", "custom/kerberos-status", "custom/pulseaudio", "cpu", "memory", "network", "bluetooth", "sway/language", "custom/suspendbutton", "custom/powerbutton", "battery"],
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "sway/window": {
    "max-length": 60
  },
  "sway/scratchpad": {
    "format": "{icon}  {count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "sway/language": {
    "format": "{shortDescription}",
    "tooltip": "false"
  },
  "clock": {
    "format": "{:%a %d %b · %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}\nWeek %V"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "cpu": {
    "interval": 10,
    "format": " {usage}%",
    "max-length": 10
  },
  "memory": {
    "interval": 30,
    "format": " {}%",
    "max-length": 10,
    "tooltip-format": "{used:0.1f}G/{total:0.1f}G"
  },
  "disk#root": {
    "interval": 60,
    "format": "󰦣 {percentage_free}%",
    "path": "/"
  },
  "disk#home": {
    "interval": 60,
    "format": "󰋜 {percentage_free}%",
    "path": "/home"
  },
  "battery": {
    "states": {"good": 80, "warning": 30, "critical": 15},
    "format": "{icon}{capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [" ", " ", " ", " ", " "]
  },
  "network": {
    "format-wifi": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}",
    "format-ethernet": "",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "format-disconnected": "⚠ disconnected",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": " {num_connections}",
    "tooltip-format": "",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)"
  },
  "custom/pulseaudio": {
    "exec": "$HOME/.config/waybar/custom/pulseaudio/pulseaudio.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "pavucontrol",
    "on-click-right": "$HOME/.config/sway/volctl.sh mute",
    "on-scroll-up": "$HOME/.config/sway/volctl.sh up",
    "on-scroll-down": "$HOME/.config/sway/volctl.sh down"
  },
  "custom/google-calendar": {
    "exec": "$HOME/.config/waybar/custom/google-calendar/google-calendar.sh",
    "return-type": "json",
    "interval": 60,
    "signal": 9,
    "max-length": 36,
    "escape": true,
    "on-click": "$HOME/.config/waybar/custom/google-calendar/google-calendar.sh --open",
    "on-click-right": "$HOME/.config/waybar/custom/google-calendar/google-calendar.sh --refresh && pkill -SIGRTMIN+9 waybar"
  },
  "custom/kerberos-status": {
    "exec": "$HOME/.config/waybar/custom/kerberos-status/kerberos-status.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "tooltip": true,
    "escape": false
  },
  "custom/media": {
    "max-length": 80,
    "on-click": "$HOME/.config/waybar/custom/media/media.sh play-pause",
    "exec": "$HOME/.config/waybar/custom/media/media.sh status",
    "interval": 1
  },
  "custom/suspendbutton": {
    "format": "󰖔",
    "on-click": "systemctl suspend",
    "tooltip": false
  },
  "custom/powerbutton": {
    "format": "⏻",
    "on-click": "shutdown now",
    "tooltip": false
  }
}
