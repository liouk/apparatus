[
	{
		"bindings": {
			"ctrl-h": [
				"action::Sequence",
				[
					["agent::SelectAgent", { "agent": "codex-acp" }],
					"agent::ToggleFocus",
				],
			],
			"ctrl-m": "workspace::ToggleBottomDock",
			"ctrl-s": "workspace::SaveWithoutFormat",
			"ctrl-w": "pane::CloseActiveItem",
			"ctrl-\\": ["workspace::SendKeystrokes", "escape"],
			"ctrl-[": "workspace::ToggleLeftDock",
			"ctrl-]": "workspace::ToggleRightDock",
			"ctrl ctrl": "command_palette::Toggle",
			"ctrl-a a": "agent::ToggleFocus",
			"ctrl-a i": "assistant::InlineAssist",
			"ctrl-a e": [
				"task::Spawn",
				{ "task_name": "open all git-modified files" },
			],
			"ctrl-a 9": ["task::Spawn", { "task_name": "github: open commit" }],
			"ctrl-a 8": ["task::Spawn", { "task_name": "github: open PR" }],
			"ctrl-a 0": ["task::Spawn", { "task_name": "github: open repo" }],
		},
	},
	{
		"context": "Workspace",
		"bindings": {
			"ctrl-a d": "diagnostics::Deploy",
			"ctrl-a l": "project_symbols::Toggle",
			"ctrl-a m": "terminal_panel::ToggleFocus",
			"ctrl-a t": "workspace::NewCenterTerminal",
			"ctrl-a [": "editor::MoveToEndOfPreviousExcerpt",
			"ctrl-a ]": "editor::MoveToStartOfNextExcerpt",
			"ctrl-f": "workspace::ToggleZoom",
		},
	},
	{
		"context": "EmptyPane",
		"bindings": {
			", a": "workspace::ClearAllNotifications",
			", c": "workspace::CloseAllDocks",
			", d": "project_panel::Toggle",
			", f": "workspace::NewSearch",
			", g": "git_panel::Toggle",
		},
	},
	{
		"context": "Editor && mode == full",
		"bindings": {
			"ctrl-a p": ["task::Spawn", { "task_name": "copy symbol reference" }],
			"ctrl-a g": "outline::Toggle",
			"ctrl-a ctrl-a": "editor::SelectAll",
			"ctrl-alt-e": "editor::SelectEnclosingSymbol",
			"ctrl-l": "workspace::ActivateNextPane",
			"ctrl-\"": "editor::ToggleAllDiffHunks",
		},
	},
	{
		"context": "GitPanel",
		"bindings": {
			"escape": "git_panel::Close",
			", g": "git_panel::Close",
		},
	},
	{
		"context": "ProjectPanel",
		"bindings": {
			"escape": "workspace::ToggleLeftDock",
		},
	},
	{
		"context": "ProjectPanel && not_editing",
		"bindings": {
			", d": "project_panel::Toggle",
			"q": "workspace::ToggleLeftDock",
			"a": "project_panel::NewFile",
			"r": "project_panel::Rename",
			"d": "project_panel::Delete",
			"f": "project_panel::NewDirectory",
			"shift-e": "project_panel::ExpandSelectedEntry",
		},
	},
	{
		"context": "Terminal",
		"bindings": {
			"ctrl-a": ["terminal::SendKeystroke", "ctrl-a"],
			"ctrl-e": ["terminal::SendKeystroke", "ctrl-e"],
			"ctrl-j": ["terminal::SendKeystroke", "ctrl-j"],
			"ctrl-k": ["terminal::SendKeystroke", "ctrl-k"],
			"ctrl-n": "workspace::NewTerminal",
			"ctrl-p": ["terminal::SendKeystroke", "ctrl-p"],
			"ctrl-t": ["terminal::SendKeystroke", "ctrl-t"],
			"ctrl-w": ["terminal::SendKeystroke", "ctrl-w"],
			"ctrl-[": ["terminal::SendKeystroke", "ctrl-["],
			"ctrl-]": ["terminal::SendKeystroke", "ctrl-]"],
			"ctrl-a m": "terminal_panel::ToggleFocus",
			"ctrl-a e": "pane::SplitAndMoveRight",
		},
	},
	{
		"context": "MarkdownPreview",
		"bindings": {
			":": "command_palette::Toggle",
		},
	},
	// =======
	// = vim =
	// =======
	{
		"context": "vim_mode == normal && !menu",
		"bindings": {
			"ctrl-a o": "editor::OpenPermalinkToLine",
			"ctrl-a c": "editor::CopyPermalinkToLine",
			"ctrl-a y": "workspace::CopyPath",
			// splits & buffers
			"ctrl-k": "pane::ActivatePreviousItem",
			"ctrl-j": "pane::ActivateNextItem",
			"ctrl-e": "pane::SplitAndMoveRight",
			"ctrl-a e": "pane::JoinIntoNext",
			"ctrl-enter": "markdown::OpenPreviewToTheSide",
			"ctrl-shift-e": "pane::JoinIntoNext",
			"ctrl-shift-w": "pane::JoinAll",
			// leader combos
			", b": "git::Blame",
			", e": "editor::SelectEnclosingSymbol",
			", r": "git::Restore",
			", t": "editor::Format",
			// global leader combos
			", a": "workspace::ClearAllNotifications",
			", c": "workspace::CloseAllDocks",
			", d": "project_panel::Toggle",
			", f": "workspace::NewSearch",
			", g": "git_panel::Toggle",
			// lsp & code
			"shift-b": "editor::BlameHover",
			"shift-k": "editor::Hover",
			"g a": "editor::ToggleCodeActions",
			"g d": "editor::GoToDefinition",
			"g D": "editor::GoToDefinitionSplit",
			"g f": "editor::OpenSelectedFilename",
			"g i": "editor::GoToImplementation",
			"g n": "editor::Rename",
			"g o": "editor::GoToTypeDefinition",
			"g O": "editor::GoToTypeDefinitionSplit",
			"g r": "editor::FindAllReferences",
			"g u": "editor::OpenUrl",
		},
	},
	{
		"context": "vim_mode == visual",
		"bindings": {
			"shift-k": "editor::MoveLineUp",
			"shift-j": "editor::MoveLineDown",
		},
	},
	{
		"context": "vim_mode == insert",
		"bindings": {
			"ctrl-[": "vim::PreviousWordStart",
			"ctrl-]": "vim::NextWordStart",
			"ctrl-v": "vim::Paste",
			"ctrl-w": "editor::DeleteToPreviousWordStart",
		},
	},
	{
		"context": "AcpThread",
		"use_key_equivalents": true,
		"bindings": {
			"shift-alt-a": null,
			"shift-alt-o": "agent::AllowOnce",
			"shift-alt-q": "agent::AllowAlways",
			"shift-alt-x": "agent::RejectOnce",
		},
	},
	{
		"context": "AgentPanel || (AgentPanel > Editor) || AcpThread || (AcpThread > Editor)",
		"bindings": {
			"ctrl-n": ["agent::NewExternalAgentThread", { "agent": "codex-acp" }],
			"ctrl-l": "multi_workspace::ToggleWorkspaceSidebar",
			"ctrl-]": "workspace::ToggleRightDock",
		},
	},
	{
		"context": "((AcpThread > Editor) || (MessageEditor > Editor)) && !Picker && !menu",
		"bindings": {
			"enter": ["action::Sequence", ["agent::Chat", "workspace::Unfollow"]],
			"ctrl-enter": "agent::ChatWithFollow",
		},
	},
	{
		"context": "ThreadsSidebar || (ThreadsSidebar > Editor)",
		"bindings": {
			"ctrl-l": "multi_workspace::ToggleWorkspaceSidebar",
			"escape": "multi_workspace::ToggleWorkspaceSidebar",
		},
	},
]
